{
  "name": "hw04-eshop-automation",
  "version": "1.0.0",
  "private": true,
  "description": "HW04 - Automation Testing for EShop SUT (Student 23127259)",
  "scripts": {
    "test": "playwright test",
    "test:fr01": "playwright test tests/fr01-register.spec.js",
    "test:fr02": "playwright test tests/fr02-login.spec.js",
    "test:fr07": "playwright test tests/fr07-cart.spec.js",
    "test:fr16": "playwright test tests/fr16-import-csv.spec.js",
    "test:hw04": "playwright test tests/fr02-login.spec.js tests/fr07-cart.spec.js tests/fr16-import-csv.spec.js",
    "test:multibrowser:fr02": "node scripts/run-multibrowser.mjs tests/fr02-login.spec.js",
    "test:multibrowser:fr07": "node scripts/run-multibrowser.mjs tests/fr07-cart.spec.js",
    "test:multibrowser:fr16": "node scripts/run-multibrowser.mjs tests/fr16-import-csv.spec.js",
    "test:multibrowser:all": "npm run test:multibrowser:fr02 && npm run test:multibrowser:fr07 && npm run test:multibrowser:fr16",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "report": "playwright show-report playwright-report/combined",
    "sut:seed": "node eshop-sut/backend/database.js",
    "sut:backend": "node eshop-sut/backend/server.js",
    "sut:web": "npm --prefix eshop-sut/frontend-web run dev",
    "sut:admin": "npm --prefix eshop-sut/frontend-admin run dev"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "marked": "^18.0.9"
  }
}
